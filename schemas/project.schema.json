{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:configpilot:project:1",
  "title": "ConfigPilot project schema version 1",
  "oneOf": [
    {
      "$ref": "#/$defs/policyCheck"
    },
    {
      "$ref": "#/$defs/templateDiff"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "workspaces"
        },
        "command": {
          "enum": ["check", "scan"]
        },
        "workspaces": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$"
              },
              "root": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "exitCode": {
                "enum": [0, 1, 2]
              },
              "report": {
                "oneOf": [
                  {
                    "$ref": "urn:configpilot:discovery:1"
                  },
                  {
                    "$ref": "urn:configpilot:report:1"
                  },
                  {
                    "$ref": "#/$defs/policyCheck"
                  },
                  {
                    "$ref": "#/$defs/templateDiff"
                  }
                ]
              }
            },
            "required": ["name", "root", "exitCode", "report"]
          },
          "maxItems": 16
        }
      },
      "required": ["schemaVersion", "kind", "command", "workspaces"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "project-error"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[A-Z_]{1,64}$"
            },
            "message": {
              "type": "string",
              "maxLength": 4096
            },
            "recommendation": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "required": ["code", "message"]
        }
      },
      "required": ["schemaVersion", "kind", "error"]
    }
  ],
  "$defs": {
    "policyCheck": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "policy-check"
        },
        "analysis": {
          "oneOf": [
            {
              "$ref": "urn:configpilot:report:1#/$defs/complete"
            },
            {
              "$ref": "urn:configpilot:report:1#/$defs/skipped"
            }
          ]
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "enum": [
                  "INVALID_DECLARATION",
                  "UNSUPPORTED_MULTILINE",
                  "COMPARISON_SKIPPED",
                  "MISSING_KEY",
                  "UNDOCUMENTED_KEY",
                  "DUPLICATE_KEY",
                  "SOURCE_UNDOCUMENTED_KEY",
                  "SOURCE_MISSING_LOCAL_KEY",
                  "SOURCE_DYNAMIC_REFERENCE",
                  "SOURCE_OPTIONAL_REFERENCE",
                  "SOURCE_POTENTIAL_SECRET",
                  "REQUIRED_KEY",
                  "EMPTY_REQUIRED_KEY"
                ]
              },
              "severity": {
                "enum": ["error", "warning", "info"]
              },
              "message": {
                "type": "string",
                "maxLength": 4096
              },
              "recommendation": {
                "type": "string",
                "maxLength": 4096
              },
              "key": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                "maxLength": 131072
              },
              "source": {
                "enum": ["template", "environment", "comparison"]
              },
              "location": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "line": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": ["file", "line"]
              },
              "relatedLocation": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "line": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": ["file", "line"]
              }
            },
            "required": [
              "code",
              "severity",
              "message",
              "recommendation",
              "source"
            ]
          },
          "maxItems": 8192
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "errors": {
              "type": "integer",
              "minimum": 0
            },
            "warnings": {
              "type": "integer",
              "minimum": 0
            },
            "info": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": ["errors", "warnings", "info", "total"]
        },
        "failed": {
          "type": "boolean"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "analysis",
        "issues",
        "summary",
        "failed"
      ]
    },
    "templateDiff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "template-diff"
        },
        "template": {
          "type": ["string", "null"]
        },
        "keys": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
          },
          "maxItems": 4096
        },
        "content": {
          "type": "string",
          "maxLength": 262144
        }
      },
      "required": ["schemaVersion", "kind", "template", "keys", "content"]
    }
  }
}
