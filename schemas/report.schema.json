{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:configpilot:report:1",
  "title": "ConfigPilot report schema version 1",
  "description": "Structural contract for analysis reports and CLI operational failures. Semantic count invariants are documented in docs/REPORT.md.",
  "oneOf": [
    {
      "$ref": "#/$defs/complete"
    },
    {
      "$ref": "#/$defs/skipped"
    },
    {
      "$ref": "#/$defs/operational"
    }
  ],
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line"],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "line": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "syntax": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "message",
        "recommendation",
        "source",
        "location"
      ],
      "properties": {
        "code": {
          "const": "INVALID_DECLARATION"
        },
        "severity": {
          "const": "error"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "recommendation": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": ["template", "environment"]
        },
        "location": {
          "$ref": "#/$defs/location"
        }
      }
    },
    "multiline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "message",
        "recommendation",
        "source",
        "location"
      ],
      "properties": {
        "code": {
          "const": "UNSUPPORTED_MULTILINE"
        },
        "severity": {
          "const": "error"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "recommendation": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": ["template", "environment"]
        },
        "location": {
          "$ref": "#/$defs/location"
        }
      }
    },
    "duplicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "message",
        "recommendation",
        "source",
        "location",
        "key",
        "relatedLocation"
      ],
      "properties": {
        "code": {
          "const": "DUPLICATE_KEY"
        },
        "severity": {
          "const": "warning"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "recommendation": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": ["template", "environment"]
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "relatedLocation": {
          "$ref": "#/$defs/location"
        }
      }
    },
    "missing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "message",
        "recommendation",
        "source",
        "location",
        "key"
      ],
      "properties": {
        "code": {
          "const": "MISSING_KEY"
        },
        "severity": {
          "const": "warning"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "recommendation": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "const": "template"
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        }
      }
    },
    "undocumented": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "message",
        "recommendation",
        "source",
        "location",
        "key"
      ],
      "properties": {
        "code": {
          "const": "UNDOCUMENTED_KEY"
        },
        "severity": {
          "const": "warning"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "recommendation": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "const": "environment"
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        }
      }
    },
    "skippedIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message", "recommendation", "source"],
      "properties": {
        "code": {
          "const": "COMPARISON_SKIPPED"
        },
        "severity": {
          "const": "info"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "recommendation": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "const": "comparison"
        }
      }
    },
    "complete": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "comparison", "issues", "summary"],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "comparison": {
          "const": "complete"
        },
        "issues": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/missing"
              },
              {
                "$ref": "#/$defs/undocumented"
              },
              {
                "$ref": "#/$defs/duplicate"
              }
            ]
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "errors",
            "warnings",
            "info",
            "total",
            "templateKeys",
            "environmentKeys",
            "sharedKeys",
            "missingKeys",
            "undocumentedKeys"
          ],
          "properties": {
            "errors": {
              "type": "integer",
              "minimum": 0
            },
            "warnings": {
              "type": "integer",
              "minimum": 0
            },
            "info": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "templateKeys": {
              "type": "integer",
              "minimum": 0
            },
            "environmentKeys": {
              "type": "integer",
              "minimum": 0
            },
            "sharedKeys": {
              "type": "integer",
              "minimum": 0
            },
            "missingKeys": {
              "type": "integer",
              "minimum": 0
            },
            "undocumentedKeys": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "skipped": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "comparison", "issues", "summary"],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "comparison": {
          "const": "skipped"
        },
        "issues": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/syntax"
              },
              {
                "$ref": "#/$defs/multiline"
              },
              {
                "$ref": "#/$defs/duplicate"
              },
              {
                "$ref": "#/$defs/skippedIssue"
              }
            ]
          },
          "contains": {
            "$ref": "#/$defs/skippedIssue"
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "errors",
            "warnings",
            "info",
            "total",
            "templateKeys",
            "environmentKeys",
            "sharedKeys",
            "missingKeys",
            "undocumentedKeys"
          ],
          "properties": {
            "errors": {
              "type": "integer",
              "minimum": 0
            },
            "warnings": {
              "type": "integer",
              "minimum": 0
            },
            "info": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "templateKeys": {
              "type": "integer",
              "minimum": 0
            },
            "environmentKeys": {
              "type": "integer",
              "minimum": 0
            },
            "sharedKeys": {
              "type": "null"
            },
            "missingKeys": {
              "type": "null"
            },
            "undocumentedKeys": {
              "type": "null"
            }
          }
        }
      }
    },
    "operational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "error"],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "recommendation"],
          "properties": {
            "code": {
              "enum": [
                "INVALID_ARGUMENTS",
                "FILE_NOT_FOUND",
                "FILE_NOT_READABLE",
                "NOT_REGULAR_FILE",
                "FILE_TOO_LARGE",
                "INVALID_ENCODING",
                "INPUT_LIMIT_EXCEEDED",
                "INTERNAL_ERROR"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "recommendation": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "enum": ["template", "environment"]
            }
          }
        }
      }
    }
  }
}
